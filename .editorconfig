root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,svelte,vue,html,css,scss,sass,less,json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
